# Copy this file to .env if you want local settings.
# Nothing here is a secret. This project does not use API keys.
# Variables already set in your shell are left unchanged.

# Set to 1 only on your own machine. Debug mode must stay off in public deploys.
FLASK_DEBUG=0

# 127.0.0.1 serves the app to your computer. Use 0.0.0.0 only if you mean to share it.
FLASK_HOST=127.0.0.1
FLASK_PORT=5001

# Public URL used for the canonical link, Open Graph tags, sitemap, and robots.txt.
# Leave this unset to use whatever address you opened in the browser.
# SITE_URL=https://example.com
